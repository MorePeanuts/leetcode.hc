{"input":{"args":[[2],[1,1],[2,2],[1],[3,3],[2],[3],[4,4],[1],[3],[4]],"ops":["LFUCache","put","put","get","put","get","get","put","get","get","get"]},"expected":[null,null,null,1,null,-1,3,null,-1,3,4],"example":true}
{"input":{"args":[[1],[1]],"ops":["LFUCache","get"]},"expected":[null,-1],"note":"capacity 1, a get on the empty cache"}
{"input":{"args":[[1],[1,1],[1]],"ops":["LFUCache","put","get"]},"expected":[null,null,1],"note":"capacity 1, put then get"}
{"input":{"args":[[1],[1,1],[1],[1],[2,2],[1],[2]],"ops":["LFUCache","put","get","get","put","get","get"]},"expected":[null,null,1,1,null,-1,2],"note":"capacity 1: a new key evicts the only one, however often it was used"}
{"input":{"args":[[1],[1,1],[1,5],[1]],"ops":["LFUCache","put","put","get"]},"expected":[null,null,null,5],"note":"capacity 1: updating the only key does not evict it"}
{"input":{"args":[[2],[1,1],[2,2],[3,3],[1],[2],[3]],"ops":["LFUCache","put","put","put","get","get","get"]},"expected":[null,null,null,null,-1,2,3],"note":"equal counters: the least recently used key is evicted"}
{"input":{"args":[[2],[1,1],[2,2],[1,10],[3,3],[1],[2],[3]],"ops":["LFUCache","put","put","put","put","get","get","get"]},"expected":[null,null,null,null,null,10,-1,3],"note":"a put that updates a key counts as a use: 2 is evicted"}
{"input":{"args":[[2],[1,1],[2,2],[2],[3,3],[1],[2],[3]],"ops":["LFUCache","put","put","get","put","get","get","get"]},"expected":[null,null,null,2,null,-1,2,3],"note":"a get counts as a use: 1 is evicted"}
{"input":{"args":[[2],[1,1],[2,2],[3],[3,3],[1],[2],[3]],"ops":["LFUCache","put","put","get","put","get","get","get"]},"expected":[null,null,null,-1,null,-1,2,3],"note":"a missed get counts for nothing: 1 is evicted"}
{"input":{"args":[[2],[1,1],[1],[1],[1],[2,2],[3,3],[1],[2],[3]],"ops":["LFUCache","put","get","get","get","put","put","get","get","get"]},"expected":[null,null,1,1,1,null,null,1,-1,3],"note":"a frequently used key survives newer keys: 2 is evicted, not 1"}
{"input":{"args":[[2],[1,1],[2,2],[1],[2],[3,3],[1],[2],[3]],"ops":["LFUCache","put","put","get","get","put","get","get","get"]},"expected":[null,null,null,1,2,null,-1,2,3],"note":"equal counters of 2: 1 was used less recently and is evicted"}
{"input":{"args":[[2],[1,1],[2,2],[2],[1],[3,3],[1],[2],[3]],"ops":["LFUCache","put","put","get","get","put","get","get","get"]},"expected":[null,null,null,2,1,null,1,-1,3],"note":"equal counters of 2: 2 was used less recently and is evicted"}
{"input":{"args":[[3],[1,1],[2,2],[3,3],[1],[1],[2],[4,4],[3],[4],[5,5],[4],[2],[1],[5]],"ops":["LFUCache","put","put","put","get","get","get","put","get","get","put","get","get","get","get"]},"expected":[null,null,null,null,1,1,2,null,-1,4,null,4,-1,1,5],"note":"capacity 3, counters 3, 2, 1: evictions follow the counters"}
{"input":{"args":[[2],[0,0],[0],[1,0],[1],[2,0],[0],[1],[2]],"ops":["LFUCache","put","get","put","get","put","get","get","get"]},"expected":[null,null,0,null,0,null,-1,0,0],"note":"key 0 and value 0: a stored 0 is not -1"}
{"input":{"args":[[3],[100000,1000000000],[0,0],[100000],[0],[50000]],"ops":["LFUCache","put","put","get","get","get"]},"expected":[null,null,null,1000000000,0,-1],"note":"the extreme keys and values"}
{"input":{"args":[[2],[1],[2],[1]],"ops":["LFUCache","get","get","get"]},"expected":[null,-1,-1,-1],"note":"only gets, nothing stored"}
{"input":{"args":[[2],[1,1],[2,2],[1],[1],[2],[2],[3,3],[3],[4,4],[1],[2],[3],[4]],"ops":["LFUCache","put","put","get","get","get","get","put","get","put","get","get","get","get"]},"expected":[null,null,null,1,1,2,2,null,3,null,-1,2,-1,4],"note":"a new key evicted again by the next new key, the older keys used more"}
{"input":{"args":[[2],[1,1],[2,2],[1,3],[1,4],[3,5],[1],[2],[3]],"ops":["LFUCache","put","put","put","put","put","get","get","get"]},"expected":[null,null,null,null,null,null,4,-1,5],"note":"repeated updates raise the counter and keep the latest value"}
{"input":{"args":[[3],[1,1],[2,2],[3,3],[4,4],[1],[2],[3],[4],[5,5],[2],[3],[4],[5]],"ops":["LFUCache","put","put","put","put","get","get","get","get","put","get","get","get","get"]},"expected":[null,null,null,null,null,-1,2,3,4,null,-1,3,4,5],"note":"capacity 3: 4 evicts 1, then 5 evicts 2, the least recently used of the counters of 2"}
{"input":{"args":[[2],[2,1],[2,2],[2],[1,1],[4,1],[2],[1],[4]],"ops":["LFUCache","put","put","get","put","put","get","get","get"]},"expected":[null,null,null,2,null,null,2,-1,1],"note":"an update is not a new key: 4 evicts 1, whose counter is the smallest"}
{"input":{"args":[[2],[1,1],[2,2],[2],[2],[3,3],[1],[1],[4,4],[1],[2],[3],[4]],"ops":["LFUCache","put","put","get","get","put","get","get","put","get","get","get","get"]},"expected":[null,null,null,2,2,null,-1,-1,null,-1,2,-1,4],"note":"the smallest counter in use rises when its last key is used: 4 evicts 3"}
